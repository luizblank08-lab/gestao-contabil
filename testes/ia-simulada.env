# Variáveis da função "conferencia-ia" para os testes: a IA é simulada pelo próprio teste
# (testes/e2e-conferencia-ia.cjs sobe um servidor falso na porta 8787). Não é uma chave real.
ANTHROPIC_API_KEY=sk-ant-teste-simulado
ANTHROPIC_BASE_URL=http://host.docker.internal:8787
CONFERENCIA_IA_LIMITE_DIA=5
